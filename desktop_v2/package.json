{
  "name": "xianyu-card-ai-cloud-preview",
  "version": "0.11.41",
  "private": true,
  "author": "Yituan",
  "description": "闲鱼餐饮卡券 AI 客服 V3.6 云端内测版",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "pnpm run build:updater && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:updater": "esbuild electron/updater-entry.cjs --bundle --platform=node --format=cjs --external:electron --outfile=electron/generated-updater.cjs",
    "build:web": "vite build",
    "build": "pnpm run build:updater && vite build && electron-builder --win nsis",
    "check": "pnpm run build:updater && vite build",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.5",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.10",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "wait-on": "9.1.0",
    "yargs": "17.7.2"
  },
  "build": {
    "appId": "cn.yituan123.xianyucardai.cloud",
    "productName": "闲鱼卡券AI客服云端内测版",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release-cloud-prod"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-cloud-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs/阿里云百炼APIKey获取图文教程.pdf",
        "to": "docs/阿里云百炼APIKey获取图文教程.pdf"
      },
      {
        "from": "docs/闲鱼卡券AI客服-V3.6-客户使用说明书-0.11.11.pdf",
        "to": "docs/闲鱼卡券AI客服-V3.6-客户使用说明书-0.11.11.pdf"
      },
      {
        "from": "assets/xianyu-ai.ico",
        "to": "tray-icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://download.yituan123.com/v3.6"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "0.11.41：修复“深圳丹竹头行不行”等口语门店问法未直接剥离“行不行”的问题，确保城市与具体门店关键词分别提取并精确查询。继续包含代金券叠加上限分规格、面额追问上下文纠正、城市门店提取、后台残留清理、自助餐报价、SKU知识归纳、商品搜索与选中同步、混合发卡和推广模式。"
    },
    "win": {
      "icon": "assets/xianyu-ai.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "XianyuCardAI-V3.6-CloudPreview-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/xianyu-ai.ico",
      "uninstallerIcon": "assets/xianyu-ai.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
